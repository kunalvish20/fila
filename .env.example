# Database
# For Supabase, use the pooled Postgres connection string from Project Settings > Database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filament_inventory?schema=public"

# API
NODE_ENV="development"
PORT=4000
JWT_SECRET="replace-with-a-long-random-secret-minimum-32-characters"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# Supabase Auth
# Google login is configured in Supabase Dashboard > Authentication > Providers > Google.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Comma-separated emails that should become ADMIN when they first sign in with Google.
SUPABASE_ADMIN_EMAILS="admin@yourcompany.com"

# SMTP / Email notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Filament Inventory <your-email@example.com>"
LOW_STOCK_EMAIL_TO="inventory@example.com"

# Frontend
VITE_API_URL="http://localhost:4000/api"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Local-only login bypass for development/testing
# Keep false for production. When true, backend skips JWT auth and runs as DEV_AUTH_BYPASS_EMAIL.
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_EMAIL="admin@filament.local"

# Frontend local bypass. Set true together with DEV_AUTH_BYPASS for no-login local testing.
VITE_AUTH_BYPASS=false
VITE_AUTH_BYPASS_EMAIL="admin@filament.local"
VITE_AUTH_BYPASS_ROLE="ADMIN"
